# Reference only: set these in the shell before launch; this file is not auto-loaded.
# Do not commit a real API key or paste it into a chat.
OPENAI_API_KEY=replace-with-your-own-key
AI_MEMORY_MODEL=replace-with-an-available-structured-output-model-id
AI_MEMORY_OPENAI_BASE_URL=https://api.openai.com/v1

# OPC Timeline RC local proxy (Node >=22), separate from the legacy Python app.
# Exact origin from chrome://extensions or edge://extensions; no wildcard.
OPC_ALLOWED_ORIGINS=chrome-extension://replace-with-your-32-letter-extension-id
# Optional. Omit to generate a pairing token on each proxy launch.
# OPC_PROXY_TOKEN=at-least-24-random-characters-not-an-openai-key
OPC_SESSION_BUDGET_USD=2
